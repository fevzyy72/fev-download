# Python-Umgebung und Zwischenstaende
.venv/
__pycache__/
*.pyc

# Mitgelieferte Fremdprogramme - holt setup.ps1, gehoert nicht ins Verzeichnis
bin/

# Bauartefakte. dist/ enthaelt die fertige Setup.exe (rund 150 MB) - die
# gehoert an ein Release, nicht in die Versionsverwaltung.
build/
dist/
*.manifest

# Erzeugtes und Persoenliches
downloads/
*.log
install.json
job.json
result.json
thumbs/

# Zugangsdaten und lokale Browserprofile niemals versehentlich weitergeben.
.env
.env.*
!.env.example
*.pem
*.key
cookies.txt
*.cookies.txt
design/**/_work/
design/**/browser-profile/

# Editor und Betriebssystem
.vscode/
Thumbs.db
desktop.ini

# Entwuerfe und Vorlagen des Designs: nur lokal (enthalten Beispielpfade, 17 MB)
design/
